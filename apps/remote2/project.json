{
  "name": "remote2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/remote2/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/remote2"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/remote2/.next"
        },
        "production": {}
      }
    },
    "port-check": {
      "executor": "./tools/port-check:check",
      "options": {
        "port": 4202
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "dependsOn": ["port-check"],
      "options": {
        "buildTarget": "remote2:build",
        "port": 4202
      },
      "configurations": {
        "development": {
          "buildTarget": "remote2:build:development"
        },
        "production": {
          "buildTarget": "remote2:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/remote2/jest.config.ts"
      }
    }
  }
}
